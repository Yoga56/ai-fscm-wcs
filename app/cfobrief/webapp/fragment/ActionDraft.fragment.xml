<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">
  <Dialog
    id="draftDialog"
    title="{path: 'ActionType', targetType: 'any', formatter: '.formatter.actionTypeText'}"
    contentWidth="42rem"
    resizable="true"
    draggable="true"
    escapeHandler=".onDraftClose">
    <content>
      <MessageStrip
        text="{InternalNote}"
        type="Information"
        showIcon="true"
        visible="{path: 'InternalNote', targetType: 'any', formatter: '.formatter.notEmpty'}"
        class="sapUiSmallMargin" />
      <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" columnsL="1" columnsM="1">
        <Label text="Status" />
        <HBox alignItems="Center">
          <ObjectStatus text="{Status}" state="{path: 'Status', targetType: 'any', formatter: '.formatter.draftState'}" inverted="true" class="sapUiSmallMarginEnd" />
          <Text text="{path: 'Engine', targetType: 'any', formatter: '.formatter.engineText'}" class="cfoMuted" />
        </HBox>
        <Label text="Recipient" required="true" />
        <Input value="{Recipient}" editable="{path: 'Status', targetType: 'any', formatter: '.formatter.isDraft'}" />
        <Label text="Subject" required="true" />
        <Input value="{Subject}" editable="{path: 'Status', targetType: 'any', formatter: '.formatter.isDraft'}" />
        <Label text="Text" required="true" />
        <TextArea value="{Body}" rows="12" growing="true" editable="{path: 'Status', targetType: 'any', formatter: '.formatter.isDraft'}" />
        <Label text="Amount" />
        <Text text="{parts: [{path: 'Amount', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />
        <Label text="Routed to" />
        <Text text="{RoutedTo}" />
        <Label text="Decision" />
        <Text text="{= %{DecidedBy} ? %{DecidedBy} + (%{DecisionNote} ? ': ' + %{DecisionNote} : '') : '-' }" />
      </form:SimpleForm>
    </content>
    <buttons>
      <Button text="{i18n>save}" visible="{path: 'Status', targetType: 'any', formatter: '.formatter.isDraft'}" press=".onDraftSave" />
      <Button text="{i18n>submit}" type="Emphasized" visible="{path: 'Status', targetType: 'any', formatter: '.formatter.isDraft'}" press=".onSubmitDraft" />
      <Button text="{i18n>approve}" type="Accept" visible="{path: 'Status', targetType: 'any', formatter: '.formatter.isRouted'}" press=".onApproveDraft" />
      <Button text="{i18n>reject}" type="Reject" visible="{path: 'Status', targetType: 'any', formatter: '.formatter.isRouted'}" press=".onRejectDraft" />
      <Button text="{i18n>close}" press=".onDraftClose" />
    </buttons>
  </Dialog>
</core:FragmentDefinition>
