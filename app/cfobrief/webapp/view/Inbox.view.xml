<mvc:View
  controllerName="cfo.brief.controller.Inbox"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  height="100%">
  <f:DynamicPage id="inboxPage" busy="{app>/busy}" busyIndicatorDelay="0" toggleHeaderOnTitleClick="false">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="What lands in the inbox" level="H1" wrapping="true" />
        </f:heading>
        <f:expandedContent>
          <Text text="The 08:00 e-mail with its base data alongside - every figure traces to one AP / AR / cash picture." />
        </f:expandedContent>
        <f:navigationActions>
          <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>cockpit}" press=".onBack" />
        </f:navigationActions>
        <f:actions>
          <Button text="{i18n>cockpit}" icon="sap-icon://business-objects-experience" press=".onBack" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:content>
      <FlexBox wrap="Wrap" alignItems="Start" class="sapUiSmallMargin">

        <Panel headerText="Base data" class="cfoBase sapUiSmallMarginEnd sapUiSmallMarginBottom" width="20rem">
          <Text text="as of {path: 'BriefDate', targetType: 'any', formatter: '.formatter.shortDate'} · {Currency} · company code {CompanyCode}" class="cfoMuted" />

          <Text text="Accounts payable" class="cfoSideTitle" />
          <ObjectAttribute title="Total AP" text="{parts: [{path: 'ApTotal', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />
          <ObjectAttribute title="Due this window" text="{parts: [{path: 'ApDueWindow', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />
          <ObjectAttribute
            title="Proposal ({path: 'RunDate', targetType: 'any', formatter: '.formatter.shortDate'})"
            text="{parts: [{path: 'RunTotal', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />
          <ObjectAttribute title="Overdue" text="{parts: [{path: 'ApOverdue', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />

          <Text text="Accounts receivable" class="cfoSideTitle" />
          <ObjectAttribute title="Total AR" text="{parts: [{path: 'ArTotal', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />
          <ObjectAttribute title="Overdue" text="{parts: [{path: 'ArOverdue', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />

          <Text text="Cash" class="cfoSideTitle" />
          <ObjectAttribute title="Cash today (bank)" text="{parts: [{path: 'CashToday', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />
          <ObjectAttribute title="Liquidity floor" text="{parts: [{path: 'LiquidityFloor', targetType: 'any'}, {path: 'Currency', targetType: 'any'}], formatter: '.formatter.money'}" />

          <Text text="Assumptions" class="cfoSideTitle" />
          <ObjectAttribute title="Horizon" text="{HorizonDays} days" />
          <ObjectAttribute title="Data" text="{= %{DataMode} === 'DEMO' ? 'Demo scenario (illustrative)' : 'Live ledger' }" />
          <ObjectAttribute title="Words" text="{parts: [{path: 'Engine', targetType: 'any'}, {path: 'ModelUsed', targetType: 'any'}], formatter: '.formatter.engineText'}" />
        </Panel>

        <Panel class="sapUiSmallMarginBottom" width="100%">
          <layoutData>
            <FlexItemData growFactor="1" minWidth="18rem" maxWidth="50rem" />
          </layoutData>
          <HBox alignItems="Center" class="sapUiSmallMarginBottom">
            <Avatar initials="AI" displaySize="S" backgroundColor="Accent6" class="sapUiSmallMarginEnd" />
            <VBox>
              <Title text="Finance Daily Brief" level="H3" />
              <Text text="brief@company · to CFO · 08:00" class="cfoMuted" />
            </VBox>
          </HBox>
          <FormattedText htmlText="{app>/inboxHtml}" class="cfoMail" />
        </Panel>

      </FlexBox>
    </f:content>
    <f:footer>
      <OverflowToolbar>
        <Text
          text="Built on the payment-run proposal. It surfaces cash impact and the few exceptions - not every invoice. Finance runs the proposal; the CFO clears the exceptions."
          wrapping="true" />
      </OverflowToolbar>
    </f:footer>
  </f:DynamicPage>
</mvc:View>
