managed implementation in class zbp_r_cfo_brief unique;
strict ( 2 );

/*
  CFO Daily Brief. A brief is a read-only snapshot produced by generateBrief.
  People only work on ActionDraft rows (edit, route, approve / reject).
  Nothing in this business object posts documents or changes payment runs.
*/

define behavior for ZR_CFO_Brief alias Brief
persistent table ztcfo_brief
lock master
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  field ( numbering : managed, readonly ) BriefUuid;
  field ( readonly ) CompanyCode, BriefDate, DataMode, Currency,
                     HorizonDays, CashToday, LiquidityFloor, RunDate,
                     NextRunDate, RunTotal, RunInvoiceCount, RunVendorCount,
                     CashAfterRun, RunHoldsFloor, LowPoint, LowPointDay,
                     LowPointDate, StressedLowPoint, StressedLowDay, Headroom,
                     FloorBreach, ScheduledBreach, LiquidityCriticality, ArTotal,
                     ArOverdue, ArOverdueChangePct, ApTotal, ApDueWindow,
                     ApOverdue, ApOverdueChangePct, ReviewCount, Headline,
                     Narrative, ExplainText, Engine, ModelUsed,
                     ErrorText, GeneratedAt, CreatedBy, CreatedAt,
                     LastChangedBy, LastChangedAt, LocalLastChangedAt;

  internal create;
  // external update is allowed but every field is read-only: it only exists so that
  // changes on dependent entities are authorized as "change" on the brief
  update;
  delete;

  static action ( authorization : global ) generateBrief parameter ZD_CFO_GenParam result [1] $self;

  action refreshAi result [1] $self;
  action simulate parameter ZD_CFO_SimParam result [0..*] ZD_CFO_SimDay;
  action askCopilot parameter ZD_CFO_AskParam result [1] ZD_CFO_Answer;
  action ( features : instance ) proposeRunExceptions result [1] $self;

  mapping for ztcfo_brief
  {
    BriefUuid            = brief_uuid;
    CompanyCode          = company_code;
    BriefDate            = brief_date;
    DataMode             = data_mode;
    Currency             = currency;
    HorizonDays          = horizon_days;
    CashToday            = cash_today;
    LiquidityFloor       = liquidity_floor;
    RunDate              = run_date;
    NextRunDate          = next_run_date;
    RunTotal             = run_total;
    RunInvoiceCount      = run_invoice_count;
    RunVendorCount       = run_vendor_count;
    CashAfterRun         = cash_after_run;
    RunHoldsFloor        = run_holds_floor;
    LowPoint             = low_point;
    LowPointDay          = low_point_day;
    LowPointDate         = low_point_date;
    StressedLowPoint     = stressed_low_point;
    StressedLowDay       = stressed_low_day;
    Headroom             = headroom;
    FloorBreach          = floor_breach;
    ScheduledBreach      = scheduled_breach;
    ArTotal              = ar_total;
    ArOverdue            = ar_overdue;
    ArOverdueChangePct   = ar_overdue_chg_pct;
    ApTotal              = ap_total;
    ApDueWindow          = ap_due_window;
    ApOverdue            = ap_overdue;
    ApOverdueChangePct   = ap_overdue_chg_pct;
    ReviewCount          = review_count;
    Headline             = headline;
    Narrative            = narrative;
    ExplainText          = explain_text;
    Engine               = engine;
    ModelUsed            = model_used;
    ErrorText            = error_text;
    GeneratedAt          = generated_at;
    CreatedBy            = created_by;
    CreatedAt            = created_at;
    LastChangedBy        = last_changed_by;
    LastChangedAt        = last_changed_at;
    LocalLastChangedAt   = local_last_changed_at;
  }

  association _RunwayDay   { internal create; }
  association _Risk        { internal create; }
  association _TradeOff    { internal create; }
  association _ActionDraft { internal create; }
}

define behavior for ZR_CFO_RunwayDay alias RunwayDay
persistent table ztcfo_runway
lock dependent by _Brief
authorization dependent by _Brief
etag master LocalLastChangedAt
{
  field ( numbering : managed, readonly ) RunwayUuid;
  field ( readonly ) BriefUuid, DayIndex, CalendarDate, Currency,
                     Inflow, Outflow, ClosingScheduled, ClosingStressed,
                     ClosingExpected, FloorAmount, FloorDelta, IsWeekend,
                     IsRunDay, IsLowPoint, LocalLastChangedAt;

  mapping for ztcfo_runway
  {
    RunwayUuid         = runway_uuid;
    BriefUuid          = brief_uuid;
    DayIndex           = day_index;
    CalendarDate       = calendar_date;
    Currency           = currency;
    Inflow             = inflow;
    Outflow            = outflow;
    ClosingScheduled   = closing_scheduled;
    ClosingStressed    = closing_stressed;
    ClosingExpected    = closing_expected;
    FloorAmount        = floor_amount;
    FloorDelta         = floor_delta;
    IsWeekend          = is_weekend;
    IsRunDay           = is_run_day;
    IsLowPoint         = is_low_point;
    LocalLastChangedAt = local_last_changed_at;
  }

  association _Brief;
}

define behavior for ZR_CFO_Risk alias Risk
persistent table ztcfo_risk
lock dependent by _Brief
authorization dependent by _Brief
etag master LocalLastChangedAt
{
  field ( numbering : managed, readonly ) RiskUuid;
  field ( readonly ) BriefUuid, RiskRank, RiskType, Epard,
                     Reference, PartnerName, Title, Detail,
                     Currency, Exposure, Probability, FloorWeight,
                     Score, Criticality, Recommendation, RecommendationText,
                     AiNote, DueBy, Status, HasDraft,
                     LocalLastChangedAt;

  internal update;

  action ( features : instance ) draftCollectionNotice result [1] $self;

  mapping for ztcfo_risk
  {
    RiskUuid           = risk_uuid;
    BriefUuid          = brief_uuid;
    RiskRank           = risk_rank;
    RiskType           = risk_type;
    Epard              = epard;
    Reference          = reference;
    PartnerName        = partner_name;
    Title              = title;
    Detail             = detail;
    Currency           = currency;
    Exposure           = exposure;
    Probability        = probability;
    FloorWeight        = floor_weight;
    Score              = score;
    Criticality        = criticality;
    Recommendation     = recommendation;
    RecommendationText = recommendation_text;
    AiNote             = ai_note;
    DueBy              = due_by;
    Status             = status;
    HasDraft           = has_draft;
    LocalLastChangedAt = local_last_changed_at;
  }

  association _Brief;
}

define behavior for ZR_CFO_TradeOff alias TradeOff
persistent table ztcfo_tradeoff
lock dependent by _Brief
authorization dependent by _Brief
etag master LocalLastChangedAt
{
  field ( numbering : managed, readonly ) TradeoffUuid;
  field ( readonly ) BriefUuid, Seq, Kind, Title,
                     Question, Currency, DeferItem, DeferName, DeferPartner,
                     DeferAmount, DeferNote, DeferCost, PayItem,
                     PayName, PayPartner, PayAmount, PayNote, ShortfallBefore,
                     ShortfallAfter, Amount, Income, AnnualizedPct,
                     Recommendation, Detail, Caveat, Confidence,
                     ConfidenceNote, Status, StatusCriticality, ActionDate,
                     AiNote, HasDraft, LocalLastChangedAt;

  internal update;

  action ( features : instance ) proposeDecision result [1] $self;

  mapping for ztcfo_tradeoff
  {
    TradeoffUuid       = tradeoff_uuid;
    BriefUuid          = brief_uuid;
    Seq                = seq;
    Kind               = kind;
    Title              = title;
    Question           = question;
    Currency           = currency;
    DeferItem          = defer_item;
    DeferName          = defer_name;
    DeferPartner       = defer_partner;
    DeferAmount        = defer_amount;
    DeferNote          = defer_note;
    DeferCost          = defer_cost;
    PayItem            = pay_item;
    PayName            = pay_name;
    PayPartner         = pay_partner;
    PayAmount          = pay_amount;
    PayNote            = pay_note;
    ShortfallBefore    = shortfall_before;
    ShortfallAfter     = shortfall_after;
    Amount             = amount;
    Income             = income;
    AnnualizedPct      = annualized_pct;
    Recommendation     = recommendation;
    Detail             = detail;
    Caveat             = caveat;
    Confidence         = confidence;
    ConfidenceNote     = confidence_note;
    Status             = status;
    ActionDate         = action_date;
    AiNote             = ai_note;
    HasDraft           = has_draft;
    LocalLastChangedAt = local_last_changed_at;
  }

  association _Brief;
}

define behavior for ZR_CFO_ActionDraft alias ActionDraft
persistent table ztcfo_action
with additional save with full data
lock dependent by _Brief
authorization dependent by _Brief
etag master LocalLastChangedAt
{
  field ( numbering : managed, readonly ) ActionUuid;
  field ( readonly ) BriefUuid, ActionType, SourceKind, SourceUuid,
                     Currency, Amount, Status, StatusCriticality,
                     Engine, RoutedTo, RoutedAt, DecidedBy,
                     DecidedAt, DecisionNote, CreatedBy, CreatedAt,
                     LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) Recipient, Subject, Body;

  // editable while the draft has not been routed
  update ( features : instance );
  delete ( features : instance );

  action ( features : instance ) submitForApproval result [1] $self;
  action ( features : instance ) approve parameter ZD_CFO_DecisionParam result [1] $self;
  action ( features : instance ) reject  parameter ZD_CFO_DecisionParam result [1] $self;

  validation validateContent on save { create; update; field Recipient, Subject, Body; }

  mapping for ztcfo_action
  {
    ActionUuid         = action_uuid;
    BriefUuid          = brief_uuid;
    ActionType         = action_type;
    SourceKind         = source_kind;
    SourceUuid         = source_uuid;
    Recipient          = recipient;
    Subject            = subject;
    Body               = body;
    InternalNote       = internal_note;
    Currency           = currency;
    Amount             = amount;
    Status             = status;
    Engine             = engine;
    RoutedTo           = routed_to;
    RoutedAt           = routed_at;
    DecidedBy          = decided_by;
    DecidedAt          = decided_at;
    DecisionNote       = decision_note;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }

  association _Brief;
}
