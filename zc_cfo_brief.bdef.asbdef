projection;
strict ( 2 );

define behavior for ZC_CFO_BRIEF alias Brief
use etag
{
  use update;
  use delete;

  use action generateBrief;
  use action refreshAi;
  use action simulate;
  use action askCopilot;
  use action proposeRunExceptions;

  use association _RunwayDay;
  use association _Risk;
  use association _TradeOff;
  use association _ActionDraft;
}

define behavior for ZC_CFO_RUNWAYDAY alias RunwayDay
use etag
{
  use association _Brief;
}

define behavior for ZC_CFO_RISK alias Risk
use etag
{
  use action draftCollectionNotice;

  use association _Brief;
}

define behavior for ZC_CFO_TRADEOFF alias TradeOff
use etag
{
  use action proposeDecision;

  use association _Brief;
}

define behavior for ZC_CFO_ACTIONDRAFT alias ActionDraft
use etag
{
  use update;
  use delete;

  use action submitForApproval;
  use action approve;
  use action reject;

  use association _Brief;
}
