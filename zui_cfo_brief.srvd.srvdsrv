@EndUserText.label: 'CFO Daily Brief - UI Service (freestyle UI5, OData V4)'
define service ZUI_CFO_BRIEF {
  expose ZC_CFO_BRIEF       as Brief;
  expose ZC_CFO_RUNWAYDAY   as RunwayDay;
  expose ZC_CFO_RISK        as Risk;
  expose ZC_CFO_TRADEOFF    as TradeOff;
  expose ZC_CFO_ACTIONDRAFT as ActionDraft;
}
